{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.saoaf.dev/schemas/v1/error-envelope.json",
  "title": "SAOAF 统一错误信封",
  "description": "所有 4xx/5xx 响应与校验失败共用的错误结构。每个校验路由命中映射唯一 error_code（I03 校验路由优先级：请求 Schema 校验 → 语义校验 → 兼容性门禁）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_code", "message", "request_id"],
  "properties": {
    "error_code": {
      "type": "string",
      "description": "机器可读唯一错误码",
      "enum": [
        "VALIDATION_UNKNOWN_FIELD",
        "VALIDATION_INVALID_ENUM",
        "VALIDATION_PAYLOAD_TOO_LARGE",
        "VALIDATION_PAYLOAD_TOO_DEEP",
        "VALIDATION_MISSING_REQUIRED",
        "SEMANTIC_INVALID",
        "COMPATIBILITY_BREAKING_CHANGE",
        "FORBIDDEN_FIELD",
        "NOT_FOUND",
        "METHOD_NOT_ALLOWED",
        "CONFLICT",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "description": "人可读说明。不得包含 Prompt、凭证或业务载荷。",
      "maxLength": 512
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "details": {
      "type": "object",
      "additionalProperties": true,
      "description": "结构化补充（如字段路径）。禁止业务正文。"
    }
  }
}
