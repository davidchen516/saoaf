{
  "realm": "saoaf-dev",
  "enabled": true,
  "displayName": "SAOAF Development",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "saoaf-viewer"
      },
      {
        "name": "saoaf-editor"
      },
      {
        "name": "saoaf-publisher"
      },
      {
        "name": "saoaf-sre"
      },
      {
        "name": "saoaf-auditor"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "resource.read",
      "protocol": "openid-connect"
    },
    {
      "name": "resource.write",
      "protocol": "openid-connect"
    },
    {
      "name": "resource.publish",
      "protocol": "openid-connect"
    },
    {
      "name": "resource.suspend",
      "protocol": "openid-connect"
    },
    {
      "name": "sovereignty.read",
      "protocol": "openid-connect"
    },
    {
      "name": "exitpack.write",
      "protocol": "openid-connect"
    },
    {
      "name": "drill.approve",
      "protocol": "openid-connect"
    },
    {
      "name": "saoaf-control-plane-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "saoaf-control-plane-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "saoaf-control-plane",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "tenant-ref",
      "description": "tenant_ref claim from user attribute",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_ref",
            "claim.name": "tenant_ref",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Standard profile claims (sub/username/email) — the e2e and adapter chain relies on them",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "preferred username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "saoaf-control-plane",
      "name": "SAOAF control-plane API audience",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "saoaf-local-pkce",
      "name": "SAOAF local PKCE client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3000/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "resource.read",
        "saoaf-control-plane-audience"
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "users": [
    {
      "username": "e2e-operator",
      "enabled": true,
      "emailVerified": true,
      "email": "op@e2e.test",
      "firstName": "E2E",
      "lastName": "Operator",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "algorithm": "pbkdf2-sha256",
          "hashIterations": 210000,
          "salt": "fDZne2cS1cGVCcvXkW32cA==",
          "hashedSaltedValue": "QRoCE5E/TruJZduhvChRE5qRcxjvEU9KlWx2fm0r99Q=",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_ref": [
          "tenant-a"
        ]
      }
    },
    {
      "username": "e2e-outsider",
      "enabled": true,
      "emailVerified": true,
      "email": "out@e2e.test",
      "firstName": "E2E",
      "lastName": "Outsider",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "algorithm": "pbkdf2-sha256",
          "hashIterations": 210000,
          "salt": "n1yAlfXX2qtybXAGduLDyw==",
          "hashedSaltedValue": "rkqs3024QfMLo4LAdWwG4xpBTwPW2pJtoCtmyEXvghA=",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_ref": [
          "tenant-b"
        ]
      }
    }
  ]
}